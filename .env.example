# NyayaLens Configuration Template
APP_NAME=NyayaLens
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Security
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB
ALLOWED_EXTENSIONS=[".pdf",".docx",".txt"]
RATE_LIMIT_PER_MINUTE=60

# Storage & Neon Database
STORAGE_DIR=./storage
TEMP_DIR=./storage/temp
# Neon Serverless Postgres (e.g. postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL=

# AI Provider Configuration
# Options: mock, openai, gemini, anthropic, groq
LLM_PROVIDER=mock
LLM_MODEL=nyayalens-legal-mock-v1
LLM_API_KEY=mock-key-not-required-for-local
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Embedding Configuration
# Options: mock, sentence-transformers, openai
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Retrieval Configuration
TOP_K_RETRIEVAL=5
HYBRID_ALPHA=0.5 # 0.0 = pure BM25, 1.0 = pure Dense Vector
MIN_CONFIDENCE_THRESHOLD=0.35
